{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "ARiCE v1",
  "fpga_id": "ice40up5k-sg48",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "iceprog",
      "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
      "usb": {"vid": "0403", "pid": "6014", "product_regex": "^Single RS232-HS"},
      "tested": true
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "35", "mhz": 12},
    "rgb_led": {
      "type": "leds",
      "pins": ["39", "40", "41"],
      "active": "low",
      "ai_hints": [
        "Wired to the FPGA's RGB LED driver pads: bit 0 RGB0, bit 1 RGB1, bit 2 RGB2.",
        "Drive them through SB_RGBA_DRV, the iCE40 UltraPlus's RGB LED driver cell (sink only)."
      ]
    }
  }
}
