{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "AZUKAR v2",
  "fpga_id": "ice40hx4k-tq144-8k",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "iceprog",
      "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
      "usb": {"vid": "0403", "pid": "6010", "product_regex": "^--.. Azukar FPGA ..--"},
      "tested": true
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "49", "mhz": 12},
    "leds": {
      "type": "leds",
      "pins": ["37", "38", "39", "41", "42", "43", "44", "45"],
      "active": "high"
    }
  }
}
