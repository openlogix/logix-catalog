{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "iCE40-HX8K Breakout Board",
  "fpga_id": "ice40hx8k-ct256",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "iceprog",
      "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
      "usb": {
        "vid": "0403",
        "pid": "6010",
        "product_regex": "^(Dual RS232-HS|Lattice FTUSB Interface Cable)"
      },
      "tested": true,
      "maintainer_notes": "USB filter (2026-11-05): was ^(Dual RS232-HS)|(Lattice FTUSB Interface Cable), whose ^ anchored only the first name; now both names must start the product name."
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "J3", "mhz": 12},
    "leds": {
      "type": "leds",
      "pins": ["C3", "B3", "C4", "C5", "A1", "A2", "B4", "B5"],
      "active": "high"
    }
  }
}
