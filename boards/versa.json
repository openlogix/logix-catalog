{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "ECP5 Versa",
  "fpga_id": "lfe5um-45f-6bg381c",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "iceprog",
      "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
      "usb": {
        "vid": "0403",
        "pid": "6010",
        "product_regex": "^(USB <-> Serial Converter|Lattice ECP5 Versa Board)"
      },
      "tested": true,
      "maintainer_notes": "USB filter (2026-11-05): was ^(USB <-> Serial Converter)|(Lattice ECP5 Versa Board), whose ^ anchored only the first name; now both names must start the product name."
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "P3", "mhz": 100, "io_standard": "LVDS"},
    "led": {"type": "leds", "pins": ["E16"], "active": "low", "io_standard": "LVCMOS25"}
  }
}
