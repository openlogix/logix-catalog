{
  "$schema": "https://www.openlogix.org/schemas/logix-board-v1.json",
  "name": "Theta Machines ETH4K",
  "fpga_id": "ice40hx4k-tq144-8k",
  "variants": [
    {
      "selector": {"connection": "usb", "memory": "flash"},
      "programmer": "iceprog",
      "args": "-d d:${BUS}/${DEV} ${BITSTREAM}",
      "usb": {"vid": "0403", "pid": "6010", "product_regex": "^ETH4K"},
      "tested": true
    }
  ],
  "resources": {
    "sys_clk": {"type": "clock", "pin": "52", "mhz": 25},
    "leds": {"type": "leds", "pins": ["41", "39", "38", "37"], "active": "high"}
  }
}
